[Unit]
Description=Raspi Recorder capture engine
After=local-fs.target
Wants=local-fs.target

[Service]
Type=simple
User=raspi-recorder
Group=raspi-recorder
SupplementaryGroups=video
WorkingDirectory=/opt/raspi-recorder/current
Environment=RASPI_RECORDER_DATA_DIR=/var/lib/raspi-recorder
Environment=RASPI_RECORDER_ENGINE_SOCKET=/run/raspi-recorder/engine.sock
UMask=0007
RuntimeDirectory=raspi-recorder
RuntimeDirectoryMode=0750
StateDirectory=raspi-recorder
StateDirectoryMode=2770
ExecStart=/opt/raspi-recorder/current/.venv/bin/raspi-recorder engine
Restart=on-failure
RestartSec=2
TimeoutStopSec=60
KillSignal=SIGTERM
KillMode=mixed
NoNewPrivileges=yes
PrivateDevices=no
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
